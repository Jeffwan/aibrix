# AIBrix Docker-Compose Configuration

# Model Configuration
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MODEL_DIR=/path/to/models
MODEL_PATH=/models

# GPU Assignment (use different GPUs for prefill and decode)
PREFILL_GPU=0
DECODE_GPU=1

# Tensor Parallelism (number of GPUs per engine)
PREFILL_TP=1
DECODE_TP=1

# P/D Disaggregation Transfer Backend
# Options: tcp, nixl, mooncake
TRANSFER_BACKEND=tcp

# KVCache Offloading (optional)
ENABLE_KVCACHE=false
KVCACHE_BACKEND=redis

# Redis Configuration
REDIS_PASSWORD=

# Gateway Routing Algorithm
# Options: pd_disaggregation, least_loaded, prefix_cache_aware, least_busy
ROUTING_ALGORITHM=pd_disaggregation
